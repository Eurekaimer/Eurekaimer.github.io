---
import type { HTMLAttributes } from "astro/types";

type Props = {
  noMarginTop?: boolean;
} & HTMLAttributes<"footer">;

const { noMarginTop = false, class: className, ...attrs } = Astro.props;
const currentYear = new Date().getFullYear();
---

<footer
  class:list={["app-layout", { "mt-auto": !noMarginTop }, className]}
  {...attrs}
>
  <div
    class="border-border flex flex-col items-center gap-4 border-t py-6 text-sm sm:py-5"
  >
    <div
      class="text-muted-foreground flex flex-wrap items-center justify-center gap-x-3 gap-y-1 text-center"
    >
      <span>Copyright &#169; 2024-{currentYear}</span>
      <span class="hidden sm:inline">|</span>
      <a href="https://icp.gov.moe/?keyword=20252030" target="_blank">
        萌ICP备20252030号
      </a>
      <span class="hidden sm:inline">|</span>
      <span>
        Running for <span id="site-runtime">...</span>
      </span>
      <span class="hidden sm:inline">|</span>
      <span>
        Made with
        <a href="https://github.com/satnaing/astro-paper" target="_blank">
          AstroPaper
        </a>
      </span>
      <!-- Filled at runtime from the Umami public share API; hidden until data loads -->
      <span id="site-visits" class="flex items-center gap-x-2" hidden>
        <span class="hidden sm:inline">|</span>
        <span id="site-visits-count"></span>
      </span>
    </div>
  </div>
</footer>

<script>
  // Visit stats use the public Umami share API — no API key, no backend.
  // 1) resolve the share link to a read-only token, 2) query website stats.
  const UMAMI_SHARE_ID = "lZCS1iezV7sf6M52";
  const UMAMI_GATEWAY = "https://gateway-us.umami.is/api";

  const startTime = new Date("2024-10-28T00:00:00+08:00").getTime();

  function updateRuntime() {
    const target = document.querySelector("#site-runtime");
    if (!target) return;

    const diff = Date.now() - startTime;
    const seconds = Math.floor(diff / 1000) % 60;
    const minutes = Math.floor(diff / 60000) % 60;
    const hours = Math.floor(diff / 3600000) % 24;
    const days = Math.floor(diff / 86400000);

    target.textContent = `${days}d ${hours}h ${minutes}m ${seconds}s`;
  }

  async function fetchUmamiStats() {
    const share = await fetch(`${UMAMI_GATEWAY}/share/${UMAMI_SHARE_ID}`);
    if (!share.ok) throw new Error("share resolve failed");
    const { websiteId, token } = (await share.json()) as {
      websiteId: string;
      token: string;
    };

    const endAt = Date.now();
    // Last 30 days covers the whole (now) lifetime of this site.
    const startAt = endAt - 30 * 24 * 60 * 60 * 1000;
    const res = await fetch(
      `${UMAMI_GATEWAY}/websites/${websiteId}/stats?startAt=${startAt}&endAt=${endAt}`,
      {
        headers: {
          "x-umami-share-token": token,
          "x-umami-share-context": "1",
        },
      }
    );
    if (!res.ok) throw new Error("stats request failed");
    return res.json();
  }

  async function updateVisitCount() {
    const container = document.querySelector<HTMLElement>("#site-visits");
    const count = document.querySelector<HTMLElement>("#site-visits-count");
    if (!container || !count) return;
    try {
      const data = (await fetchUmamiStats()) as {
        pageviews: number;
        visitors: number;
        comparison?: { pageviews: number; visitors: number };
      };
      // Fresh sites: the gateway reports the recorded sessions under
      // `comparison` while `pageviews` is still 0 — fall back so the counter
      // shows real numbers instead of 0 until the main window fills in.
      const pageviews = data.pageviews || data.comparison?.pageviews || 0;
      const visitors = data.visitors || data.comparison?.visitors || 0;
      const fmt = new Intl.NumberFormat("en-US");
      count.textContent = `${fmt.format(pageviews)} pageviews · ${fmt.format(
        visitors
      )} visitors`;
      container.hidden = false;
    } catch {
      // Share link invalid or the gateway is unreachable — leave the footer
      // exactly as-is: no error text, no partial layout shift.
      container.hidden = true;
    }
  }

  updateRuntime();
  setInterval(updateRuntime, 1000);
  updateVisitCount();
  setInterval(updateVisitCount, 60_000);

  // Re-fetch after client-side navigations (Astro view transitions swap the footer).
  document.addEventListener("astro:page-load", updateVisitCount);
</script>
